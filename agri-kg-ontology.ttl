@prefix : <http://agrikg.cn/ontology/fused/v1#> .
@prefix f: <http://agrikg.cn/ontology/fused/v1#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix agrovoc: <http://aims.fao.org/aos/agrovoc/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://agrikg.cn/ontology/fused/v1#> .

<http://agrikg.cn/ontology/fused/v1#> rdf:type owl:Ontology ;
                                       dc:description "核心精简版本体 AKO-F v1.9，共 61 个 OWL 类，只保留实体层（52 类，图谱节点类型体系：Crop 6 子类/BioticStress 4 子类/Symptom 5 子类/Treatment/EnvFactor 3 直接子类（天气下 7 子类/土壤下 4 子类/水质下 3 子类）/GrowthStage/Location 3 子类/Time 3 子类/Observation 4 类）、事件层（9 类：EventType 根+ 8 类事件类型）与关系层（14 类对象属性：10 类核心关系 + 4 类观测关系）。时间通过实体层Time 类（TimePoint/TimeInterval/PhenologicalPeriod）及时间戳属性（time_value/start_time/end_time/obs_timestamp/occurrence_time）建模，不依赖外部时间本体。v1.9 大气改天气、并入降水/光照/空气温湿度、去除水质悬浮物。"@zh ;
                                       dc:title "Agri-KG Ontology - Fused (AKO-F)"@en ,
                                                "融合版农业知识图谱本体"@zh ;
                                       dcterms:created "2026-08-29"^^xsd:date ;
                                       dcterms:modified "2026-08-31"^^xsd:date ;
                                       dcterms:version "1.9" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/version
dcterms:version rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://agrikg.cn/ontology/fused/v1#affects
f:affects rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( f:Disease
                                      f:Pest
                                      f:WeedCompetition
                                    )
                      ] ;
          rdfs:range f:Crop ;
          rdfs:comment "病害/虫害/杂草竞争→危害→作物。"@zh ;
          rdfs:label "危害"@zh .


###  http://agrikg.cn/ontology/fused/v1#causedBy
f:causedBy rdf:type owl:ObjectProperty ;
           rdfs:domain f:Disease ;
           rdfs:range f:Pathogen ;
           rdfs:comment "病害→由病原引起→病原。"@zh ;
           rdfs:label "由病原引起"@zh .


###  http://agrikg.cn/ontology/fused/v1#dependOn
f:dependOn rdf:type owl:ObjectProperty ;
           owl:inverseOf f:favor ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( f:Disease
                                       f:Pest
                                       f:WeedCompetition
                                     )
                       ] ;
           rdfs:range f:EnvFactor ;
           rdfs:comment "病害/虫害/杂草竞争→依赖→环境因子；与 favor 互为逆语义。"@zh ;
           rdfs:label "依赖"@zh .


###  http://agrikg.cn/ontology/fused/v1#depicts
f:depicts rdf:type owl:ObjectProperty ;
          rdfs:domain f:Observation ;
          rdfs:range f:Entity ;
          rdfs:label "描绘"@zh .


###  http://agrikg.cn/ontology/fused/v1#exhibit
f:exhibit rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( f:Disease
                                      f:Pest
                                    )
                      ] ;
          rdfs:range f:AnatomicalSymptom ;
          rdfs:comment "病害/虫害→表现→症状。range 限定为部位症状（AnatomicalSymptom），不连接功能症状（FunctionalSymptom），实现事件层与因果层的硬隔离。"@zh ;
          rdfs:label "表现"@zh .


###  http://agrikg.cn/ontology/fused/v1#favor
f:favor rdf:type owl:ObjectProperty ;
        rdfs:domain f:EnvFactor ;
        rdfs:range [ rdf:type owl:Class ;
                     owl:unionOf ( f:Disease
                                   f:Pest
                                   f:WeedCompetition
                                 )
                   ] ;
        rdfs:comment "病三角：环境→促进→病害/虫害/杂草竞争。"@zh ;
        rdfs:label "促进"@zh .


###  http://agrikg.cn/ontology/fused/v1#influence
f:influence rdf:type owl:ObjectProperty ;
            rdfs:domain f:EnvFactor ;
            rdfs:range f:Crop ;
            rdfs:comment "环境→影响→作物。"@zh ;
            rdfs:label "影响"@zh .


###  http://agrikg.cn/ontology/fused/v1#measures
f:measures rdf:type owl:ObjectProperty ;
           rdfs:domain f:Observation ;
           rdfs:range f:EnvFactor ;
           rdfs:label "测量"@zh .


###  http://agrikg.cn/ontology/fused/v1#observedAt
f:observedAt rdf:type owl:ObjectProperty ;
             rdfs:domain f:Observation ;
             rdfs:range f:Time ;
             rdfs:label "观测时间"@zh .


###  http://agrikg.cn/ontology/fused/v1#observedIn
f:observedIn rdf:type owl:ObjectProperty ;
             rdfs:domain f:Observation ;
             rdfs:range f:Location ;
             rdfs:label "观测地点"@zh .


###  http://agrikg.cn/ontology/fused/v1#occurIn
f:occurIn rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( f:Disease
                                      f:Pest
                                      f:WeedCompetition
                                    )
                      ] ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( f:GrowthStage
                                     f:Time
                                   )
                     ] ;
          rdfs:comment "病害/虫害/杂草竞争 → 发生于 → 生育期/时间。"@zh ;
          rdfs:label "发生于"@zh .


###  http://agrikg.cn/ontology/fused/v1#resist
f:resist rdf:type owl:ObjectProperty ;
         rdfs:domain f:Crop ;
         rdfs:range [ rdf:type owl:Class ;
                      owl:unionOf ( f:Disease
                                    f:Pest
                                  )
                    ] ;
         rdfs:comment "作物→抗→病害/虫害。"@zh ;
         rdfs:label "抗性"@zh .


###  http://agrikg.cn/ontology/fused/v1#spreadIn
f:spreadIn rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( f:Disease
                                       f:Pest
                                       f:WeedCompetition
                                     )
                       ] ;
           rdfs:range f:Location ;
           rdfs:comment "病害/虫害/杂草竞争→扩散于→空间。"@zh ;
           rdfs:label "扩散于"@zh .


###  http://agrikg.cn/ontology/fused/v1#treat
f:treat rdf:type owl:ObjectProperty ;
        rdfs:domain f:Treatment ;
        rdfs:range [ rdf:type owl:Class ;
                     owl:unionOf ( f:Disease
                                   f:Pest
                                   f:WeedCompetition
                                 )
                   ] ;
        rdfs:comment "措施→防治→病害/虫害/杂草竞争。"@zh ;
        rdfs:label "防治"@zh .


#################################################################
#    Data properties
#################################################################

###  http://agrikg.cn/ontology/fused/v1#aliases
f:aliases rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:string ;
          rdfs:comment "同义归一（稻瘟病=稻热病=稻瘟）；v1.5 由 entityAliases 统一并入。"@zh ;
          rdfs:label "别名"@zh .


###  http://agrikg.cn/ontology/fused/v1#area
f:area rdf:type owl:DatatypeProperty ;
       rdfs:domain f:Plot ;
       rdfs:range xsd:decimal ;
       rdfs:comment "地块面积（亩）。"@zh ;
       rdfs:label "面积"@zh .


###  http://agrikg.cn/ontology/fused/v1#asset_uri
f:asset_uri rdf:type owl:DatatypeProperty ;
            rdfs:domain f:MediaAsset ;
            rdfs:range xsd:string ;
            rdfs:comment "文件路径/URL。"@zh ;
            rdfs:label "资产地址"@zh .


###  http://agrikg.cn/ontology/fused/v1#color
f:color rdf:type owl:DatatypeProperty ;
        rdfs:domain f:Symptom ;
        rdfs:range xsd:string ;
        rdfs:comment "褐/黑/黄。"@zh ;
        rdfs:label "颜色"@zh .


###  http://agrikg.cn/ontology/fused/v1#competition_type
f:competition_type rdf:type owl:DatatypeProperty ;
                   rdfs:domain f:WeedCompetition ;
                   rdfs:range xsd:string ;
                   rdfs:comment "争水/争肥/争光等资源竞争类型。"@zh ;
                   rdfs:label "竞争类型"@zh .


###  http://agrikg.cn/ontology/fused/v1#data_source
f:data_source rdf:type owl:DatatypeProperty ;
              rdfs:domain f:Observation ;
              rdfs:range xsd:string ;
              rdfs:comment "田间传感器/文献/人工记录。"@zh ;
              rdfs:label "数据源"@zh .


###  http://agrikg.cn/ontology/fused/v1#description
f:description rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string ;
              rdfs:comment "该对象的文字说明。"@zh ;
              rdfs:label "描述"@zh .


###  http://agrikg.cn/ontology/fused/v1#dominant_species
f:dominant_species rdf:type owl:DatatypeProperty ;
                   rdfs:domain f:WeedCompetition ;
                   rdfs:range xsd:string ;
                   rdfs:comment "主要杂草种类（稗草/鸭舌草/千金子）；v1.7注：未来建 Weed 类后升级为对象属性指向杂草实体。"@zh ;
                   rdfs:label "优势杂草种类"@zh .


###  http://agrikg.cn/ontology/fused/v1#dosage
f:dosage rdf:type owl:DatatypeProperty ;
         rdfs:domain f:Treatment ;
         rdfs:range xsd:string ;
         rdfs:comment "如20g/亩。"@zh ;
         rdfs:label "用药量"@zh .


###  http://agrikg.cn/ontology/fused/v1#efficacy
f:efficacy rdf:type owl:DatatypeProperty ;
           rdfs:domain f:Treatment ;
           rdfs:range xsd:string ;
           rdfs:comment "v1.7新增：防治效果（如85%）。"@zh ;
           rdfs:label "防效"@zh .


###  http://agrikg.cn/ontology/fused/v1#end_time
f:end_time rdf:type owl:DatatypeProperty ;
           rdfs:domain f:Time ;
           rdfs:range xsd:dateTime ;
           rdfs:comment "TimeInterval 区间终点。"@zh ;
           rdfs:label "结束时间"@zh .


###  http://agrikg.cn/ontology/fused/v1#entity_uri
f:entity_uri rdf:type owl:DatatypeProperty ;
             rdfs:domain f:Entity ;
             rdfs:range xsd:anyURI ;
             rdfs:comment "实体唯一标识，优先复用 AGROVOC/CO/PO 编码。"@zh ;
             rdfs:label "实体URI"@zh .


###  http://agrikg.cn/ontology/fused/v1#event_description
f:event_description rdf:type owl:DatatypeProperty ;
                    rdfs:domain f:EventType ;
                    rdfs:range xsd:string ;
                    rdfs:comment "文字摘要。"@zh ;
                    rdfs:label "事件描述"@zh .


###  http://agrikg.cn/ontology/fused/v1#event_id
f:event_id rdf:type owl:DatatypeProperty ;
           rdfs:domain f:EventType ;
           rdfs:range xsd:string ;
           rdfs:comment "如EVT-2026-001。"@zh ;
           rdfs:label "事件编号"@zh .


###  http://agrikg.cn/ontology/fused/v1#factor_value
f:factor_value rdf:type owl:DatatypeProperty ;
               rdfs:domain f:EnvFactor ;
               rdfs:range xsd:decimal ;
               rdfs:comment "v1.7数值化：如 25（温度值）；温度/湿度/光照/大气等子类共用；定性值（如“高湿”）用 name/label 表达，不写入。"@zh ;
               rdfs:label "数值"@zh .


###  http://agrikg.cn/ontology/fused/v1#growth_days
f:growth_days rdf:type owl:DatatypeProperty ;
              rdfs:domain f:Crop ;
              rdfs:range xsd:int ;
              rdfs:comment "全生育期长度（120天）。"@zh ;
              rdfs:label "全生育期天数"@zh .


###  http://agrikg.cn/ontology/fused/v1#harm_level
f:harm_level rdf:type owl:DatatypeProperty ;
             rdfs:domain f:BioticStress ;
             rdfs:range xsd:string ;
             rdfs:comment "v1.7新增：病害/虫害/病原/杂草竞争共用的危害等级（轻/中/重）。"@zh ;
             rdfs:label "危害等级"@zh .


###  http://agrikg.cn/ontology/fused/v1#image_format
f:image_format rdf:type owl:DatatypeProperty ;
               rdfs:domain f:ImageAsset ;
               rdfs:range xsd:string ;
               rdfs:comment "jpg/png/tif。"@zh ;
               rdfs:label "格式"@zh .


###  http://agrikg.cn/ontology/fused/v1#latitude
f:latitude rdf:type owl:DatatypeProperty ;
           rdfs:domain f:Location ;
           rdfs:range xsd:decimal ;
           rdfs:comment "如23.13。"@zh ;
           rdfs:label "纬度"@zh .


###  http://agrikg.cn/ontology/fused/v1#longitude
f:longitude rdf:type owl:DatatypeProperty ;
            rdfs:domain f:Location ;
            rdfs:range xsd:decimal ;
            rdfs:comment "如113.27。"@zh ;
            rdfs:label "经度"@zh .


###  http://agrikg.cn/ontology/fused/v1#measurement_value
f:measurement_value rdf:type owl:DatatypeProperty ;
                    rdfs:domain f:SensorSeries ;
                    rdfs:range xsd:decimal ;
                    rdfs:comment "v1.7新增：传感器当前/代表测量值。"@zh ;
                    rdfs:label "测量值"@zh .


###  http://agrikg.cn/ontology/fused/v1#name
f:name rdf:type owl:DatatypeProperty ;
       rdfs:range xsd:string ;
       rdfs:comment "规范名（水稻、稻瘟病、三环唑）。"@zh ;
       rdfs:label "名称"@zh .


###  http://agrikg.cn/ontology/fused/v1#obs_id
f:obs_id rdf:type owl:DatatypeProperty ;
         rdfs:domain f:Observation ;
         rdfs:range xsd:string ;
         rdfs:comment "如OBS-1023。"@zh ;
         rdfs:label "观测编号"@zh .


###  http://agrikg.cn/ontology/fused/v1#obs_timestamp
f:obs_timestamp rdf:type owl:DatatypeProperty ;
                rdfs:domain f:Observation ;
                rdfs:range xsd:dateTime ;
                rdfs:comment "观测发生时间。"@zh ;
                rdfs:label "时间戳"@zh .


###  http://agrikg.cn/ontology/fused/v1#occurrence_time
f:occurrence_time rdf:type owl:DatatypeProperty ;
                  rdfs:domain f:EventType ;
                  rdfs:range xsd:dateTime ;
                  rdfs:comment "事件发生时间。"@zh ;
                  rdfs:label "发生时间"@zh .


###  http://agrikg.cn/ontology/fused/v1#pathogen_kingdom
f:pathogen_kingdom rdf:type owl:DatatypeProperty ;
                   rdfs:domain f:Pathogen ;
                   rdfs:range xsd:string ;
                   rdfs:comment "真菌/细菌/病毒/线虫。"@zh ;
                   rdfs:label "类群"@zh .


###  http://agrikg.cn/ontology/fused/v1#peak_period
f:peak_period rdf:type owl:DatatypeProperty ;
              rdfs:domain f:Pest ;
              rdfs:range xsd:string ;
              rdfs:comment "如6月下旬—7月上旬。"@zh ;
              rdfs:label "发生高峰期"@zh .


###  http://agrikg.cn/ontology/fused/v1#peak_season
f:peak_season rdf:type owl:DatatypeProperty ;
              rdfs:domain f:Disease ;
              rdfs:range xsd:string ;
              rdfs:comment "春/夏/秋。"@zh ;
              rdfs:label "易发季节"@zh .


###  http://agrikg.cn/ontology/fused/v1#pest_order
f:pest_order rdf:type owl:DatatypeProperty ;
             rdfs:domain f:Pest ;
             rdfs:range xsd:string ;
             rdfs:comment "鳞翅目/同翅目/鞘翅目。"@zh ;
             rdfs:label "分类目"@zh .


###  http://agrikg.cn/ontology/fused/v1#plot_id
f:plot_id rdf:type owl:DatatypeProperty ;
          rdfs:domain f:Plot ;
          rdfs:range xsd:string ;
          rdfs:comment "地块唯一编号。"@zh ;
          rdfs:label "地块编号"@zh .


###  http://agrikg.cn/ontology/fused/v1#province
f:province rdf:type owl:DatatypeProperty ;
           rdfs:domain f:Location ;
           rdfs:range xsd:string ;
           rdfs:comment "如广东省；子类 Region/Plot/Facility 继承。"@zh ;
           rdfs:label "省份"@zh .


###  http://agrikg.cn/ontology/fused/v1#record_interval
f:record_interval rdf:type owl:DatatypeProperty ;
                  rdfs:domain f:SensorSeries ;
                  rdfs:range xsd:string ;
                  rdfs:comment "v1.7新增：相邻记录时间间隔。"@zh ;
                  rdfs:label "记录间隔"@zh .


###  http://agrikg.cn/ontology/fused/v1#resolution
f:resolution rdf:type owl:DatatypeProperty ;
             rdfs:domain f:ImageAsset ;
             rdfs:range xsd:string ;
             rdfs:comment "如4032×3024。"@zh ;
             rdfs:label "分辨率"@zh .


###  http://agrikg.cn/ontology/fused/v1#safety_interval
f:safety_interval rdf:type owl:DatatypeProperty ;
                  rdfs:domain f:Treatment ;
                  rdfs:range xsd:string ;
                  rdfs:comment "v1.7新增：最后一次施药距收获的安全天数。"@zh ;
                  rdfs:label "安全间隔期"@zh .


###  http://agrikg.cn/ontology/fused/v1#sampling_rate
f:sampling_rate rdf:type owl:DatatypeProperty ;
                rdfs:domain f:SensorSeries ;
                rdfs:range xsd:string ;
                rdfs:comment "如1次/小时。"@zh ;
                rdfs:label "采样率"@zh .


###  http://agrikg.cn/ontology/fused/v1#secondary_usage
f:secondary_usage rdf:type owl:DatatypeProperty ;
                  rdfs:domain f:Crop ;
                  rdfs:range xsd:string ;
                  rdfs:comment "v1.7新增：跨类作物的副用途（主用途由 6 个 Crop 子类表达；如大豆主用途粮食、副用途油料）。"@zh ;
                  rdfs:label "副用途"@zh .


###  http://agrikg.cn/ontology/fused/v1#sensor_type
f:sensor_type rdf:type owl:DatatypeProperty ;
              rdfs:domain f:SensorSeries ;
              rdfs:range xsd:string ;
              rdfs:comment "温湿度计/雨量计。"@zh ;
              rdfs:label "传感器类型"@zh .


###  http://agrikg.cn/ontology/fused/v1#series_json
f:series_json rdf:type owl:DatatypeProperty ;
              rdfs:domain f:SensorSeries ;
              rdfs:range xsd:string ;
              rdfs:comment "v1.7新增：时序数据序列（JSON）。"@zh ;
              rdfs:label "时序数据"@zh .


###  http://agrikg.cn/ontology/fused/v1#severity_grade
f:severity_grade rdf:type owl:DatatypeProperty ;
                 rdfs:domain f:Disease ;
                 rdfs:range xsd:string ;
                 rdfs:comment "轻/中/重。"@zh ;
                 rdfs:label "严重度"@zh .


###  http://agrikg.cn/ontology/fused/v1#source_url
f:source_url rdf:type owl:DatatypeProperty ;
             rdfs:domain f:TextDocument ;
             rdfs:range xsd:string ;
             rdfs:comment "文献来源链接。"@zh ;
             rdfs:label "来源URL"@zh .


###  http://agrikg.cn/ontology/fused/v1#stage_code
f:stage_code rdf:type owl:DatatypeProperty ;
             rdfs:domain f:GrowthStage ;
             rdfs:range xsd:string ;
             rdfs:comment "如GS-03（分蘖期）。"@zh ;
             rdfs:label "阶段编码"@zh .


###  http://agrikg.cn/ontology/fused/v1#start_time
f:start_time rdf:type owl:DatatypeProperty ;
             rdfs:domain f:Time ;
             rdfs:range xsd:dateTime ;
             rdfs:comment "TimeInterval 区间起点。"@zh ;
             rdfs:label "开始时间"@zh .


###  http://agrikg.cn/ontology/fused/v1#symptom_form
f:symptom_form rdf:type owl:DatatypeProperty ;
               rdfs:domain f:Symptom ;
               rdfs:range xsd:string ;
               rdfs:comment "斑点/枯萎/腐烂/畸形。"@zh ;
               rdfs:label "形态"@zh .


###  http://agrikg.cn/ontology/fused/v1#text_content
f:text_content rdf:type owl:DatatypeProperty ;
               rdfs:domain f:TextDocument ;
               rdfs:range xsd:string ;
               rdfs:comment "报告/记录正文。"@zh ;
               rdfs:label "文本内容"@zh .


###  http://agrikg.cn/ontology/fused/v1#time_value
f:time_value rdf:type owl:DatatypeProperty ;
             rdfs:domain f:Time ;
             rdfs:range xsd:dateTime ;
             rdfs:comment "TimePoint 用（2026-06-15）。"@zh ;
             rdfs:label "时间值"@zh .


###  http://agrikg.cn/ontology/fused/v1#transmission_mode
f:transmission_mode rdf:type owl:DatatypeProperty ;
                    rdfs:domain f:Disease ;
                    rdfs:range xsd:string ;
                    rdfs:comment "v1.7新增：风雨/虫媒/土传等传播途径。"@zh ;
                    rdfs:label "传播方式"@zh .


###  http://agrikg.cn/ontology/fused/v1#treatment_category
f:treatment_category rdf:type owl:DatatypeProperty ;
                     rdfs:domain f:Treatment ;
                     rdfs:range xsd:string ;
                     rdfs:comment "化学/农艺/生物。"@zh ;
                     rdfs:label "类别"@zh .


###  http://agrikg.cn/ontology/fused/v1#typical_days
f:typical_days rdf:type owl:DatatypeProperty ;
               rdfs:domain f:GrowthStage ;
               rdfs:range xsd:int ;
               rdfs:comment "该阶段通常持续天数。"@zh ;
               rdfs:label "典型天数"@zh .


###  http://agrikg.cn/ontology/fused/v1#unit
f:unit rdf:type owl:DatatypeProperty ;
       rdfs:domain f:EnvFactor ;
       rdfs:range xsd:string ;
       rdfs:comment "℃/%/mm；子类共用。"@zh ;
       rdfs:label "单位"@zh .


###  http://agrikg.cn/ontology/fused/v1#usage_method
f:usage_method rdf:type owl:DatatypeProperty ;
               rdfs:domain f:Treatment ;
               rdfs:range xsd:string ;
               rdfs:comment "喷雾/拌种/灌根。"@zh ;
               rdfs:label "用法"@zh .


###  http://agrikg.cn/ontology/fused/v1#variety
f:variety rdf:type owl:DatatypeProperty ;
          rdfs:domain f:Crop ;
          rdfs:range xsd:string ;
          rdfs:comment "具体品种（汕优63、扬麦16）。"@zh ;
          rdfs:label "品种"@zh .


###  http://agrikg.cn/ontology/fused/v1#weed_density
f:weed_density rdf:type owl:DatatypeProperty ;
               rdfs:domain f:WeedCompetition ;
               rdfs:range xsd:decimal ;
               rdfs:comment "单位面积杂草株数（株/㎡），衡量竞争强度。"@zh ;
               rdfs:label "杂草密度"@zh .


#################################################################
#    Classes
#################################################################

###  http://agrikg.cn/ontology/fused/v1#AirHumidityParam
f:AirHumidityParam rdf:type owl:Class ;
                   rdfs:subClassOf f:WeatherParam ;
                   rdfs:comment "v1.9由湿度改名：空气相对湿度（区别于土壤湿度 SoilMoistureParam）；高湿促进稻瘟病等病害。"@zh ;
                   rdfs:label "空气湿度参数"@zh .


###  http://agrikg.cn/ontology/fused/v1#AirPressureParam
f:AirPressureParam rdf:type owl:Class ;
                   rdfs:subClassOf f:WeatherParam ;
                   rdfs:comment "v1.7新增：气压参数；天气系统判读，影响病害流行。"@zh ;
                   rdfs:label "气压参数"@zh .


###  http://agrikg.cn/ontology/fused/v1#AirTemperatureParam
f:AirTemperatureParam rdf:type owl:Class ;
                      rdfs:subClassOf f:WeatherParam ;
                      rdfs:comment "v1.9由温度改名：空气温度（区别于土壤温度 SoilTemperatureParam）。"@zh ;
                      rdfs:label "空气温度参数"@zh .


###  http://agrikg.cn/ontology/fused/v1#BioticStress
f:BioticStress rdf:type owl:Class ;
               rdfs:subClassOf f:Entity ;
               rdfs:comment "v1.3新增：对作物造成生物性危害的胁迫因子抽象父类，子类包括病害、虫害/害虫、病原、杂草竞争。"@zh ;
               rdfs:label "生物胁迫"@zh .


###  http://agrikg.cn/ontology/fused/v1#CO2Param
f:CO2Param rdf:type owl:Class ;
           rdfs:subClassOf f:WeatherParam ;
           rdfs:comment "v1.7新增：CO₂ 浓度参数；高CO₂加剧部分叶部病害并影响光合；可作 favor/influence 关系主体。"@zh ;
           rdfs:label "CO₂浓度参数"@zh .


###  http://agrikg.cn/ontology/fused/v1#CashCrop
f:CashCrop rdf:type owl:Class ;
           rdfs:subClassOf f:Crop ;
           rdfs:comment "v1.4新增：以经济收益为主的工业原料作物（棉花/油菜/花生/甘蔗）。"@zh ;
           rdfs:label "经济作物"@zh .


###  http://agrikg.cn/ontology/fused/v1#CerealCrop
f:CerealCrop rdf:type owl:Class ;
             rdfs:subClassOf f:Crop ;
             rdfs:comment "v1.4新增：供人类食用的禾谷类和豆类主粮（水稻/小麦/玉米/大豆）。"@zh ;
             rdfs:label "粮食作物"@zh .


###  http://agrikg.cn/ontology/fused/v1#ControlEvent
f:ControlEvent rdf:type owl:Class ;
               rdfs:subClassOf f:EventType ;
               rdfs:comment "槽位(C,D/P,TREATMENT,τ)；模态：文本。"@zh ;
               rdfs:label "防治事件"@zh .


###  http://agrikg.cn/ontology/fused/v1#Crop
f:Crop rdf:type owl:Class ;
       rdfs:subClassOf f:Entity ;
       rdfs:comment "受危害/栽培对象（水稻/玉米/番茄）。"@zh ;
       rdfs:label "作物"@zh .


###  http://agrikg.cn/ontology/fused/v1#Disease
f:Disease rdf:type owl:Class ;
          rdfs:subClassOf f:BioticStress ;
          rdfs:label "病害"@zh .


###  http://agrikg.cn/ontology/fused/v1#DiseaseOccurrenceEvent
f:DiseaseOccurrenceEvent rdf:type owl:Class ;
                         rdfs:subClassOf f:EventType ;
                         rdfs:comment "槽位(C,D,S,τ,λ,A)；模态：文本+图像(+环境)。"@zh ;
                         rdfs:label "病害发生事件"@zh .


###  http://agrikg.cn/ontology/fused/v1#Entity
f:Entity rdf:type owl:Class ;
         owl:disjointUnionOf ( f:BioticStress
                               f:Crop
                               f:EnvFactor
                               f:GrowthStage
                               f:Location
                               f:Observation
                               f:Symptom
                               f:Time
                               f:Treatment
                             ) ;
         rdfs:comment "知识单元 s/o 的可能类型根；9 个直接子类两两不相交（v1.3：Disease/Pest/Pathogen 归入 BioticStress）。"@zh ;
         rdfs:label "实体"@zh .


###  http://agrikg.cn/ontology/fused/v1#EnvFactor
f:EnvFactor rdf:type owl:Class ;
            rdfs:subClassOf f:Entity ;
            rdfs:label "环境因子"@zh .


###  http://agrikg.cn/ontology/fused/v1#EnvironmentalInfluenceEvent
f:EnvironmentalInfluenceEvent rdf:type owl:Class ;
                              rdfs:subClassOf f:EventType ;
                              rdfs:comment "槽位(A,C,D,τ)；模态：环境+文本。"@zh ;
                              rdfs:label "环境影响事件"@zh .


###  http://agrikg.cn/ontology/fused/v1#EventType
f:EventType rdf:type owl:Class ;
            rdfs:comment "事件作为动态过程类型，表达“发生了什么”；通过事件类型承载动态知识。"@zh ;
            rdfs:label "事件类型"@zh .


###  http://agrikg.cn/ontology/fused/v1#Facility
f:Facility rdf:type owl:Class ;
           rdfs:subClassOf f:Location ;
           rdfs:label "设施"@zh .


###  http://agrikg.cn/ontology/fused/v1#FoliarSymptom
f:FoliarSymptom rdf:type owl:Class ;
                rdfs:subClassOf f:AnatomicalSymptom ;
                rdfs:label "叶部症状"@zh .


###  http://agrikg.cn/ontology/fused/v1#ForageCrop
f:ForageCrop rdf:type owl:Class ;
             rdfs:subClassOf f:Crop ;
             rdfs:comment "v1.4新增：供畜禽饲用的作物（苜蓿/青贮玉米/黑麦草）。"@zh ;
             rdfs:label "饲料作物"@zh .


###  http://agrikg.cn/ontology/fused/v1#FruitCrop
f:FruitCrop rdf:type owl:Class ;
            rdfs:subClassOf f:Crop ;
            rdfs:comment "v1.4新增：多年生木本/藤本果实作物（苹果/柑橘/葡萄/桃）。"@zh ;
            rdfs:label "果树作物"@zh .


###  http://agrikg.cn/ontology/fused/v1#FruitSymptom
f:FruitSymptom rdf:type owl:Class ;
               rdfs:subClassOf f:AnatomicalSymptom ;
               rdfs:label "果实症状"@zh .


###  http://agrikg.cn/ontology/fused/v1#GrowthDevelopmentEvent
f:GrowthDevelopmentEvent rdf:type owl:Class ;
                         rdfs:subClassOf f:EventType ;
                         rdfs:comment "槽位(C,GROWTH_STAGE/器官,τ)。"@zh ;
                         rdfs:label "生长发育事件"@zh .


###  http://agrikg.cn/ontology/fused/v1#GrowthStage
f:GrowthStage rdf:type owl:Class ;
              rdfs:subClassOf f:Entity ;
              rdfs:comment "分蘖期/孕穗期/抽穗期等；时序锚点。"@zh ;
              rdfs:label "生育期"@zh .


###  http://agrikg.cn/ontology/fused/v1#ImageAsset
f:ImageAsset rdf:type owl:Class ;
             rdfs:subClassOf f:MediaAsset ;
             rdfs:label "图像"@zh .


###  http://agrikg.cn/ontology/fused/v1#LightParam
f:LightParam rdf:type owl:Class ;
             rdfs:subClassOf f:WeatherParam ;
             rdfs:comment "v1.9并入天气：光照强度/时长，影响光合与病原孢子萌发。"@zh ;
             rdfs:label "光照"@zh .


###  http://agrikg.cn/ontology/fused/v1#Location
f:Location rdf:type owl:Class ;
           rdfs:subClassOf f:Entity ;
           rdfs:comment "只作 r_spread_in/观测 客体与边属性（修订 B 角色双重）。"@zh ;
           rdfs:label "空间"@zh .


###  http://agrikg.cn/ontology/fused/v1#MediaAsset
f:MediaAsset rdf:type owl:Class ;
             rdfs:subClassOf f:Observation ;
             rdfs:label "媒体资产"@zh .


###  http://agrikg.cn/ontology/fused/v1#MedicinalCrop
f:MedicinalCrop rdf:type owl:Class ;
                rdfs:subClassOf f:Crop ;
                rdfs:comment "v1.4新增：以药用成分为收获目标的作物（人参/枸杞/黄芪）。"@zh ;
                rdfs:label "药用作物"@zh .


###  http://agrikg.cn/ontology/fused/v1#Observation
f:Observation rdf:type owl:Class ;
              rdfs:subClassOf f:Entity ;
              rdfs:comment "图谱增强实体：多模态挂载（环境观测/图像/文本证据），不进入核心语义 Mask。"@zh ;
              rdfs:label "观测"@zh .


###  http://agrikg.cn/ontology/fused/v1#PanicleSymptom
f:PanicleSymptom rdf:type owl:Class ;
                 rdfs:subClassOf f:AnatomicalSymptom ;
                 rdfs:label "穗部症状"@zh .


###  http://agrikg.cn/ontology/fused/v1#Pathogen
f:Pathogen rdf:type owl:Class ;
           rdfs:subClassOf f:BioticStress ;
           rdfs:comment "新增（吸收 A）：病三角缺失的第三角，与病害分离的独立实体。"@zh ;
           rdfs:label "病原"@zh .


###  http://agrikg.cn/ontology/fused/v1#Pest
f:Pest rdf:type owl:Class ;
       rdfs:subClassOf f:BioticStress ;
       rdfs:comment "新增（吸收 A）：与病害对称承载虫害主线。"@zh ;
       rdfs:label "虫害/害虫"@zh .


###  http://agrikg.cn/ontology/fused/v1#PestOccurrenceEvent
f:PestOccurrenceEvent rdf:type owl:Class ;
                      rdfs:subClassOf f:EventType ;
                      rdfs:comment "槽位(C,P,S,τ,λ,A)。"@zh ;
                      rdfs:label "虫害发生事件"@zh .


###  http://agrikg.cn/ontology/fused/v1#PhenologicalPeriod
f:PhenologicalPeriod rdf:type owl:Class ;
                     rdfs:subClassOf f:Time ;
                     rdfs:label "物候期"@zh .


###  http://agrikg.cn/ontology/fused/v1#PhenologyEvent
f:PhenologyEvent rdf:type owl:Class ;
                 rdfs:subClassOf f:EventType ;
                 rdfs:comment "槽位(C,GROWTH_STAGE,τ)；模态：文本+环境。"@zh ;
                 rdfs:label "物候事件"@zh .


###  http://agrikg.cn/ontology/fused/v1#Plot
f:Plot rdf:type owl:Class ;
       rdfs:subClassOf f:Location ;
       rdfs:label "地块"@zh .


###  http://agrikg.cn/ontology/fused/v1#PrecipitationParam
f:PrecipitationParam rdf:type owl:Class ;
                     rdfs:subClassOf f:WeatherParam ;
                     rdfs:comment "v1.9并入天气：降雨/降雪量，影响空气湿度与病害流行条件。"@zh ;
                     rdfs:label "降水"@zh .


###  http://agrikg.cn/ontology/fused/v1#QualityFormationEvent
f:QualityFormationEvent rdf:type owl:Class ;
                        rdfs:subClassOf f:EventType ;
                        rdfs:comment "槽位(C,性状,τ)。"@zh ;
                        rdfs:label "品质形成事件"@zh .


###  http://agrikg.cn/ontology/fused/v1#Region
f:Region rdf:type owl:Class ;
         rdfs:subClassOf f:Location ;
         rdfs:label "产区"@zh .


###  http://agrikg.cn/ontology/fused/v1#RootSymptom
f:RootSymptom rdf:type owl:Class ;
              rdfs:subClassOf f:AnatomicalSymptom ;
              rdfs:label "根部症状"@zh .


###  http://agrikg.cn/ontology/fused/v1#SensorSeries
f:SensorSeries rdf:type owl:Class ;
               rdfs:subClassOf f:MediaAsset ;
               rdfs:label "传感器时序"@zh .


###  http://agrikg.cn/ontology/fused/v1#SoilMoistureParam
f:SoilMoistureParam rdf:type owl:Class ;
                    rdfs:subClassOf f:SoilParam ;
                    rdfs:comment "v1.8新增：土壤含水量（田间持水量/萎蔫系数），区别于空气湿度；影响根系吸收与土传病害（如立枯病）。"@zh ;
                    rdfs:label "土壤湿度参数"@zh .


###  http://agrikg.cn/ontology/fused/v1#SoilNutrientParam
f:SoilNutrientParam rdf:type owl:Class ;
                    rdfs:subClassOf f:SoilParam ;
                    rdfs:comment "v1.8新增：氮磷钾及有机质含量；影响作物生长与抗病性。"@zh ;
                    rdfs:label "土壤养分参数"@zh .


###  http://agrikg.cn/ontology/fused/v1#SoilPHParam
f:SoilPHParam rdf:type owl:Class ;
              rdfs:subClassOf f:SoilParam ;
              rdfs:comment "v1.8新增：土壤酸碱度；影响养分有效性（磷/铁/锌）与土传病害发生；可作 favor/influence 关系主体。"@zh ;
              rdfs:label "土壤pH参数"@zh .


###  http://agrikg.cn/ontology/fused/v1#SoilParam
f:SoilParam rdf:type owl:Class ;
            rdfs:subClassOf f:EnvFactor ;
            rdfs:comment "v1.8拆分为 pH/湿度/温度/养分 4 子类。"@zh ;
            rdfs:label "土壤"@zh .


###  http://agrikg.cn/ontology/fused/v1#SoilTemperatureParam
f:SoilTemperatureParam rdf:type owl:Class ;
                       rdfs:subClassOf f:SoilParam ;
                       rdfs:comment "v1.8新增：土温；影响种子萌发、根系活动与土传病原活性。"@zh ;
                       rdfs:label "土壤温度参数"@zh .


###  http://agrikg.cn/ontology/fused/v1#SpreadEvent
f:SpreadEvent rdf:type owl:Class ;
              rdfs:subClassOf f:EventType ;
              rdfs:comment "槽位(D/P,LOCATION,τ)；模态：文本。"@zh ;
              rdfs:label "扩散事件"@zh .


###  http://agrikg.cn/ontology/fused/v1#StemSymptom
f:StemSymptom rdf:type owl:Class ;
              rdfs:subClassOf f:AnatomicalSymptom ;
              rdfs:label "茎部症状"@zh .


###  http://agrikg.cn/ontology/fused/v1#Symptom
f:Symptom rdf:type owl:Class ;
          rdfs:subClassOf f:Entity ;
          rdfs:comment "症状实体化，按部位子类型细分（吸收 A）。"@zh ;
          rdfs:label "症状"@zh .


###  http://agrikg.cn/ontology/fused/v1#AnatomicalSymptom
f:AnatomicalSymptom rdf:type owl:Class ;
                    rdfs:subClassOf f:Symptom ;
                    rdfs:comment "部位维度症状子类：按作物发病部位细分（叶/果/穗/根/茎）。"@zh ;
                    rdfs:label "部位症状"@zh .


###  http://agrikg.cn/ontology/fused/v1#FunctionalSymptom
f:FunctionalSymptom rdf:type owl:Class ;
                    rdfs:subClassOf f:Symptom ;
                    rdfs:comment "功能维度症状子类：按生理功能/性状维度细分（光合/生殖/产量/品质/胁迫响应）。与部位维度并存，可多重继承。"@zh ;
                    rdfs:label "功能症状"@zh .


###  http://agrikg.cn/ontology/fused/v1#TextDocument
f:TextDocument rdf:type owl:Class ;
               rdfs:subClassOf f:MediaAsset ;
               rdfs:label "文本资料"@zh .


###  http://agrikg.cn/ontology/fused/v1#Time
f:Time rdf:type owl:Class ;
       rdfs:subClassOf f:Entity ;
       rdfs:comment "只作 r_occur_in/观测 客体与边属性。"@zh ;
       rdfs:label "时间"@zh .


###  http://agrikg.cn/ontology/fused/v1#TimeInterval
f:TimeInterval rdf:type owl:Class ;
               rdfs:subClassOf f:Time ;
               rdfs:label "时间区间"@zh .


###  http://agrikg.cn/ontology/fused/v1#TimePoint
f:TimePoint rdf:type owl:Class ;
            rdfs:subClassOf f:Time ;
            rdfs:label "时间点"@zh .


###  http://agrikg.cn/ontology/fused/v1#Treatment
f:Treatment rdf:type owl:Class ;
            rdfs:subClassOf f:Entity ;
            rdfs:comment "药剂/农艺措施（三环唑/排水晒田）。"@zh ;
            rdfs:label "防治措施"@zh .


###  http://agrikg.cn/ontology/fused/v1#VegetableCrop
f:VegetableCrop rdf:type owl:Class ;
                rdfs:subClassOf f:Crop ;
                rdfs:comment "v1.4新增：以柔嫩器官供食用的作物（番茄/黄瓜/白菜/辣椒）。"@zh ;
                rdfs:label "蔬菜作物"@zh .


###  http://agrikg.cn/ontology/fused/v1#WaterHeavyMetalParam
f:WaterHeavyMetalParam rdf:type owl:Class ;
                       rdfs:subClassOf f:WaterQualityParam ;
                       rdfs:comment "v1.8新增：镉/汞/砷/铅等含量；食品安全红线，影响农产品安全。"@zh ;
                       rdfs:label "水质重金属参数"@zh .


###  http://agrikg.cn/ontology/fused/v1#WaterPHParam
f:WaterPHParam rdf:type owl:Class ;
               rdfs:subClassOf f:WaterQualityParam ;
               rdfs:comment "v1.8新增：灌溉水酸碱度（适宜 6.5-8.5）；影响土壤pH与养分吸收。"@zh ;
               rdfs:label "水质pH参数"@zh .


###  http://agrikg.cn/ontology/fused/v1#WaterQualityParam
f:WaterQualityParam rdf:type owl:Class ;
                    rdfs:subClassOf f:EnvFactor ;
                    rdfs:comment "v1.8拆分为 pH/盐分/重金属 3 子类（v1.9去除悬浮物）。"@zh ;
                    rdfs:label "水质"@zh .


###  http://agrikg.cn/ontology/fused/v1#WaterSalinityParam
f:WaterSalinityParam rdf:type owl:Class ;
                     rdfs:subClassOf f:WaterQualityParam ;
                     rdfs:comment "v1.8新增：含盐量/电导率（EC）；盐分过高造成土壤盐渍化与作物盐害。"@zh ;
                     rdfs:label "水质盐分参数"@zh .


###  http://agrikg.cn/ontology/fused/v1#WeatherParam
f:WeatherParam rdf:type owl:Class ;
               rdfs:subClassOf f:EnvFactor ;
               rdfs:comment "v1.3新增（v1.9由大气改名）：天气与空气环境参数父类；下分 CO₂/风速/气压/降水/光照/空气温度/空气湿度 7 子类，数值经继承的 factor_value/unit 承载。"@zh ;
               rdfs:label "天气"@zh .


###  http://agrikg.cn/ontology/fused/v1#WeedCompetition
f:WeedCompetition rdf:type owl:Class ;
                  rdfs:subClassOf f:BioticStress ;
                  rdfs:comment "v1.3新增：杂草与作物争夺水肥光等资源的生物胁迫类型。"@zh ;
                  rdfs:label "杂草竞争"@zh .


###  http://agrikg.cn/ontology/fused/v1#WindSpeedParam
f:WindSpeedParam rdf:type owl:Class ;
                 rdfs:subClassOf f:WeatherParam ;
                 rdfs:comment "v1.7新增：风速参数；影响孢子/害虫远距离扩散。"@zh ;
                 rdfs:label "风速参数"@zh .


#################################################################
#    Individuals
#################################################################

###  http://agrikg.cn/ontology/fused/v1#Apple
f:Apple rdf:type owl:NamedIndividual ,
                 f:FruitCrop ;
        f:entity_uri "agrovoc:c_6789" ;
        rdfs:label "苹果"@zh .


###  http://agrikg.cn/ontology/fused/v1#Blast
f:Blast rdf:type owl:NamedIndividual ,
                 f:Disease ;
        f:affects f:Rice ;
        f:causedBy f:Pyricularia ;
        f:dependOn f:HighHumidity ;
        f:exhibit f:LeafLesion ;
        f:occurIn f:BootingStage ,
                  f:June2026 ;
        f:spreadIn f:SouthChina ;
        rdfs:label "稻瘟病"@zh .


###  http://agrikg.cn/ontology/fused/v1#BootingStage
f:BootingStage rdf:type owl:NamedIndividual ,
