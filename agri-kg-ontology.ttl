#################################################################
#    扩展：Symptom 功能维度子类（新增，挂在 FunctionalSymptom 下）
#################################################################

###  http://agrikg.cn/ontology/fused/v1#PhysiologicalSymptom
f:PhysiologicalSymptom rdf:type owl:Class ;
                       rdfs:subClassOf f:FunctionalSymptom ;
                       rdfs:comment "生理生化类症状：光合/呼吸/激素/氧化/养分等功能状态变化。与部位子类并存，可多重继承。"@zh ;
                       rdfs:label "生理症状"@zh .


###  http://agrikg.cn/ontology/fused/v1#ReproductiveSymptom
f:ReproductiveSymptom rdf:type owl:Class ;
                      rdfs:subClassOf f:FunctionalSymptom ;
                      rdfs:comment "生殖发育类症状：花粉活力/授粉/着果/结实/颖花等生殖过程状态变化。"@zh ;
                      rdfs:label "生殖症状"@zh .


###  http://agrikg.cn/ontology/fused/v1#YieldSymptom
f:YieldSymptom rdf:type owl:Class ;
               rdfs:subClassOf f:FunctionalSymptom ;
               rdfs:comment "产量构成类症状：产量/千粒重/穗粒数/空壳率/灌浆等产量性状状态变化。"@zh ;
               rdfs:label "产量症状"@zh .


###  http://agrikg.cn/ontology/fused/v1#QualitySymptom
f:QualitySymptom rdf:type owl:Class ;
                 rdfs:subClassOf f:FunctionalSymptom ;
                 rdfs:comment "品质类症状：垩白度/毒素/食味/营养成分等品质性状状态变化。"@zh ;
                 rdfs:label "品质症状"@zh .


###  http://agrikg.cn/ontology/fused/v1#StressResponseSymptom
f:StressResponseSymptom rdf:type owl:Class ;
                        rdfs:subClassOf f:FunctionalSymptom ;
                        rdfs:comment "胁迫响应类症状：氧化应激/渗透调节/激素信号/胁迫记忆等生物胁迫响应状态。"@zh ;
                        rdfs:label "胁迫响应症状"@zh .


#################################################################
#    扩展：因果关系体系（新增）
#################################################################

###  http://agrikg.cn/ontology/fused/v1#causes
f:causes rdf:type owl:ObjectProperty ;
         rdfs:domain f:Entity ;
         rdfs:range f:Entity ;
         rdfs:comment "通用因果父关系。子关系 triggers/propagates/alleviates 继承此关系，用于因果链统一遍历推理。实际建边使用子关系而非 causes 本身。"@zh ;
         rdfs:label "导致"@zh .


###  http://agrikg.cn/ontology/fused/v1#triggers
f:triggers rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf f:causes ;
           rdfs:domain f:EnvFactor ;
           rdfs:range f:FunctionalSymptom ;
           rdfs:comment "环境因子触发作物功能症状（极性：促进）。range 限定为功能症状（FunctionalSymptom），不连接部位症状，实现因果层与事件层的硬隔离。区别于 favor（环境→病虫害的病三角关联）。"@zh ;
           rdfs:label "触发"@zh .


###  http://agrikg.cn/ontology/fused/v1#propagates
f:propagates rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf f:causes ;
             rdfs:domain f:Entity ;
             rdfs:range f:Entity ;
             rdfs:comment "因果传导关系：A 的变化传导导致 B 的变化。跨任意实体类型，极性由 causal_polarity 区分。"@zh ;
             rdfs:label "传导"@zh .


###  http://agrikg.cn/ontology/fused/v1#alleviates
f:alleviates rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf f:causes ;
             rdfs:domain f:Treatment ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( f:Symptom
                                        f:EnvFactor
                                        f:BioticStress
                                      )
                        ] ;
             rdfs:comment "措施缓解症状/胁迫（极性：抑制）。如 灌溉 alleviates 干旱胁迫。区别于 treat（措施→病虫害的防治）。"@zh ;
             rdfs:label "缓解"@zh .


#################################################################
#    扩展：复合环境因子组成关系（新增）
#################################################################

###  http://agrikg.cn/ontology/fused/v1#composed_of
f:composed_of rdf:type owl:ObjectProperty ;
              rdfs:domain f:EnvFactor ;
              rdfs:range f:EnvFactor ;
              rdfs:comment "复合环境因子的组成关系，如干热风 composed_of 高温、低湿、大风。"@zh ;
              rdfs:label "由...组成"@zh .


#################################################################
#    扩展：因果关系数据属性（新增，边属性，不设 domain）
#################################################################

###  http://agrikg.cn/ontology/fused/v1#causal_confidence
f:causal_confidence rdf:type owl:DatatypeProperty ;
                    rdfs:range xsd:decimal ;
                    rdfs:comment "因果置信度 0.0-1.0。用于因果关系（causes）的边属性。"@zh ;
                    rdfs:label "因果置信度"@zh .


###  http://agrikg.cn/ontology/fused/v1#causal_polarity
f:causal_polarity rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:string ;
                  rdfs:comment "因果极性：promote（促进/加重）或 inhibit（抑制/缓解）。用于因果关系（causes）的边属性。"@zh ;
                  rdfs:label "因果极性"@zh .


###  http://agrikg.cn/ontology/fused/v1#causal_evidence
f:causal_evidence rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:string ;
                  rdfs:comment "因果关系的原文证据片段。用于因果关系（causes）的边属性。"@zh ;
                  rdfs:label "因果证据"@zh .


###  http://agrikg.cn/ontology/fused/v1#causal_condition
f:causal_condition rdf:type owl:DatatypeProperty ;
                   rdfs:range xsd:string ;
                   rdfs:comment "因果成立的条件（生育期/阈值/作物等），如'孕穗期'。用于因果关系（causes）的边属性。"@zh ;
                   rdfs:label "因果条件"@zh .


