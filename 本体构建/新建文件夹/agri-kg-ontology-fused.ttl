# =============================================================================
# 融合版本体 Agri-KG Ontology - Fused (AKO-F) v1.2
# 与《融合版本体设计AKO-F_v1.md》完全对齐
# 以 B《农业知识图谱本体构建报告》四层+七元组+Mask 为骨架，
# 吸收 A《AKO 本体》的细粒度（病原/虫害/症状部位/时空/观测）与关系拆分，
# 修订 B 形式化漏洞（occur_in 主体、affect 拆分、事件/关系边界、TIME/LOCATION 角色）。
#
# v1.2 新增：知识单元层事件间关联（ku_precedes / ku_causes / ku_inhibits），
#   在保持"事件是知识单元载体、不是图谱节点"定位不变的前提下，显式表达事件间时序/因果/抑制关系。
# v1.1 新增：EventSlot/Evidence/CausalRule/TimeTriple/SpaceTriple/RelationType/KnowledgeObject，
#   全部核心关系 domain/range 精确收紧。
# 命名空间：http://agrikg.cn/ontology/fused/v1#
# =============================================================================

@prefix f:       <http://agrikg.cn/ontology/fused/v1#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix agrovoc: <http://aims.fao.org/aos/agrovoc/> .

# =============================================================================
# 0. 本体元信息
# =============================================================================
f: a owl:Ontology ;
    dc:title "融合版农业知识图谱本体"@zh ;
    dc:title "Agri-KG Ontology - Fused (AKO-F)"@en ;
    dc:description "以 B 开题方案本体（四层+七元组+Mask）为骨架、吸收 A 细粒度的融合版本体：10 类实体、10 类核心关系+4 类观测关系、8 类事件类型、知识单元七元组、事件槽位、证据、因果规则、知识单元层事件间关联（ku_precedes/ku_causes/ku_inhibits）。与设计文档 AKO-F_v1.md 完全对齐。"@zh ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    dcterms:version "1.2" ;
    owl:imports time: .

# =============================================================================
# 1. 实体类型体系（10 类语义实体 + OBSERVATION 观测增强）
#    对应文档 §2；语义主体类 = 前 8 类，LOCATION/TIME 为时空属性类
# =============================================================================
f:Entity a owl:Class ; rdfs:label "实体"@zh ;
    rdfs:comment "知识单元 s/o 的可能类型根；11 个直接子类两两不相交。"@zh .

# ---- 1.1 语义主体类（前 8 类，可作关系主客体）----
f:Crop a owl:Class ; rdfs:subClassOf f:Entity ; rdfs:label "作物"@zh ;
    rdfs:comment "受危害/栽培对象（水稻/玉米/番茄）。"@zh .
f:Disease a owl:Class ; rdfs:subClassOf f:Entity ; rdfs:label "病害"@zh .
f:Pest a owl:Class ; rdfs:subClassOf f:Entity ; rdfs:label "虫害/害虫"@zh ;
    rdfs:comment "新增（吸收 A）：与病害对称承载虫害主线。"@zh .
f:Pathogen a owl:Class ; rdfs:subClassOf f:Entity ; rdfs:label "病原"@zh ;
    rdfs:comment "新增（吸收 A）：病三角缺失的第三角，与病害分离的独立实体。"@zh .
f:Symptom a owl:Class ; rdfs:subClassOf f:Entity ; rdfs:label "症状"@zh ;
    rdfs:comment "症状实体化，按部位子类型细分（吸收 A）。"@zh .
f:FoliarSymptom  a owl:Class ; rdfs:subClassOf f:Symptom ; rdfs:label "叶部症状"@zh .
f:StemSymptom    a owl:Class ; rdfs:subClassOf f:Symptom ; rdfs:label "茎部症状"@zh .
f:PanicleSymptom a owl:Class ; rdfs:subClassOf f:Symptom ; rdfs:label "穗部症状"@zh .
f:RootSymptom    a owl:Class ; rdfs:subClassOf f:Symptom ; rdfs:label "根部症状"@zh .
f:FruitSymptom   a owl:Class ; rdfs:subClassOf f:Symptom ; rdfs:label "果实症状"@zh .
f:Treatment a owl:Class ; rdfs:subClassOf f:Entity ; rdfs:label "防治措施"@zh ;
    rdfs:comment "药剂/农艺措施（三环唑/排水晒田）。"@zh .
f:EnvFactor a owl:Class ; rdfs:subClassOf f:Entity ; rdfs:label "环境因子"@zh .
f:TemperatureParam    a owl:Class ; rdfs:subClassOf f:EnvFactor ; rdfs:label "温度"@zh .
f:HumidityParam       a owl:Class ; rdfs:subClassOf f:EnvFactor ; rdfs:label "湿度"@zh .
f:LightParam          a owl:Class ; rdfs:subClassOf f:EnvFactor ; rdfs:label "光照"@zh .
f:PrecipitationParam  a owl:Class ; rdfs:subClassOf f:EnvFactor ; rdfs:label "降水"@zh .
f:SoilParam           a owl:Class ; rdfs:subClassOf f:EnvFactor ; rdfs:label "土壤"@zh .
f:WaterQualityParam   a owl:Class ; rdfs:subClassOf f:EnvFactor ; rdfs:label "水质"@zh .
f:GrowthStage a owl:Class ; rdfs:subClassOf f:Entity ; rdfs:label "生育期"@zh ;
    rdfs:comment "分蘖期/孕穗期/抽穗期等；时序锚点。"@zh .

# ---- 1.2 时空属性类（LOCATION/TIME，只作客体与边属性）----
f:Location a owl:Class ; rdfs:subClassOf f:Entity ; rdfs:label "空间"@zh ;
    rdfs:comment "只作 r_spread_in/观测 客体与边属性（修订 B 角色双重）。"@zh .
f:Region   a owl:Class ; rdfs:subClassOf f:Location ; rdfs:label "产区"@zh .
f:Plot     a owl:Class ; rdfs:subClassOf f:Location ; rdfs:label "地块"@zh .
f:Facility a owl:Class ; rdfs:subClassOf f:Location ; rdfs:label "设施"@zh .
f:Time a owl:Class ; rdfs:subClassOf f:Entity ; rdfs:label "时间"@zh ;
    rdfs:comment "只作 r_occur_in/观测 客体与边属性。"@zh .
f:TimePoint          a owl:Class ; rdfs:subClassOf f:Time ; rdfs:label "时间点"@zh .
f:TimeInterval       a owl:Class ; rdfs:subClassOf f:Time ; rdfs:label "时间区间"@zh .
f:PhenologicalPeriod a owl:Class ; rdfs:subClassOf f:Time ; rdfs:label "物候期"@zh .

# ---- 1.3 观测增强类（OBSERVATION，多模态挂载，不进入核心语义 Mask）----
f:Observation a owl:Class ; rdfs:subClassOf f:Entity ; rdfs:label "观测"@zh ;
    rdfs:comment "图谱增强实体：多模态挂载（环境观测/图像/文本证据），不进入核心语义 Mask。"@zh .
f:MediaAsset   a owl:Class ; rdfs:subClassOf f:Observation ; rdfs:label "媒体资产"@zh .
f:ImageAsset   a owl:Class ; rdfs:subClassOf f:MediaAsset ; rdfs:label "图像"@zh .
f:SensorSeries a owl:Class ; rdfs:subClassOf f:MediaAsset ; rdfs:label "传感器时序"@zh .
f:TextDocument a owl:Class ; rdfs:subClassOf f:MediaAsset ; rdfs:label "文本资料"@zh .

# ---- 1.4 语义主体类（unionOf 前 8 类，对应文档 §2 图谱角色划分）----
f:SemanticSubject a owl:Class ;
    owl:unionOf ( f:Crop f:Disease f:Pest f:Pathogen f:Symptom
                  f:Treatment f:EnvFactor f:GrowthStage ) ;
    rdfs:label "语义主体类"@zh ;
    rdfs:comment "前 8 类语义实体的并集，可作知识单元主体 s。"@zh .

# 知识单元客体 o 的允许类型 = 语义主体类 ∪ {LOCATION, TIME}
f:KnowledgeObject a owl:Class ;
    owl:unionOf ( f:SemanticSubject f:Location f:Time ) ;
    rdfs:label "知识单元客体允许类型"@zh ;
    rdfs:comment "对应文档 §7.1：o ∈ 前8类语义实体 ∪ {LOCATION, TIME}。"@zh .

# 实体类型两两不相交（保持 Mask 的类别互斥）
f:Entity owl:disjointUnionOf ( f:Crop f:Disease f:Pest f:Pathogen f:Symptom
    f:Treatment f:EnvFactor f:GrowthStage f:Location f:Time f:Observation ) .

# =============================================================================
# 2. 关系类型枚举（RelationType）—— 修正 hasRelation 指向 ObjectProperty 的问题
#    对应文档 §3.1 的 10 类核心关系；关系类型作为个体，供 KnowledgeUnit.hasRelation 引用
# =============================================================================
f:RelationType a owl:Class ; rdfs:label "关系类型"@zh ;
    rdfs:comment "10 类核心关系的枚举类；关系类型作为命名个体，知识单元通过 hasRelation 引用。"@zh .

f:RelAffects    a f:RelationType, owl:NamedIndividual ; rdfs:label "危害"@zh .
f:RelInfluence  a f:RelationType, owl:NamedIndividual ; rdfs:label "影响"@zh .
f:RelFavor      a f:RelationType, owl:NamedIndividual ; rdfs:label "促进"@zh .
f:RelExhibit    a f:RelationType, owl:NamedIndividual ; rdfs:label "表现"@zh .
f:RelCausedBy   a f:RelationType, owl:NamedIndividual ; rdfs:label "由病原引起"@zh .
f:RelTreat      a f:RelationType, owl:NamedIndividual ; rdfs:label "防治"@zh .
f:RelOccurIn    a f:RelationType, owl:NamedIndividual ; rdfs:label "发生于"@zh .
f:RelDependOn   a f:RelationType, owl:NamedIndividual ; rdfs:label "依赖"@zh .
f:RelSpreadIn   a f:RelationType, owl:NamedIndividual ; rdfs:label "扩散于"@zh .
f:RelResist     a f:RelationType, owl:NamedIndividual ; rdfs:label "抗性"@zh .

# =============================================================================
# 3. 事件类型体系（8 类，可扩展；事件=知识单元复合载体，非实体）
#    对应文档 §4
# =============================================================================
f:EventType a owl:Class ; rdfs:label "事件类型"@zh ;
    rdfs:comment "事件是知识单元的复合载体（r 取事件类型时按槽位填充），不作为图谱实体节点。"@zh .

f:DiseaseOccurrenceEvent a owl:Class ; rdfs:subClassOf f:EventType ; rdfs:label "病害发生事件"@zh ;
    rdfs:comment "槽位(C,D,S,τ,λ,A)；模态：文本+图像(+环境)。"@zh .
f:PestOccurrenceEvent a owl:Class ; rdfs:subClassOf f:EventType ; rdfs:label "虫害发生事件"@zh ;
    rdfs:comment "槽位(C,P,S,τ,λ,A)；新增。"@zh .
f:EnvironmentalInfluenceEvent a owl:Class ; rdfs:subClassOf f:EventType ; rdfs:label "环境影响事件"@zh ;
    rdfs:comment "槽位(A,C,D,τ)；模态：环境+文本。"@zh .
f:ControlEvent a owl:Class ; rdfs:subClassOf f:EventType ; rdfs:label "防治事件"@zh ;
    rdfs:comment "槽位(C,D/P,TREATMENT,τ)；模态：文本。"@zh .
f:PhenologyEvent a owl:Class ; rdfs:subClassOf f:EventType ; rdfs:label "物候事件"@zh ;
    rdfs:comment "槽位(C,GROWTH_STAGE,τ)；模态：文本+环境。"@zh .
f:SpreadEvent a owl:Class ; rdfs:subClassOf f:EventType ; rdfs:label "扩散事件"@zh ;
    rdfs:comment "槽位(D/P,LOCATION,τ)；模态：文本。"@zh .
f:GrowthDevelopmentEvent a owl:Class ; rdfs:subClassOf f:EventType ; rdfs:label "生长发育事件"@zh ;
    rdfs:comment "槽位(C,GROWTH_STAGE/器官,τ)；新增（吸收 A）。"@zh .
f:QualityFormationEvent a owl:Class ; rdfs:subClassOf f:EventType ; rdfs:label "品质形成事件"@zh ;
    rdfs:comment "槽位(C,性状,τ)；新增（吸收 A）。"@zh .

# =============================================================================
# 4. 事件槽位（EventSlot）—— 对应文档 §4.2 论元槽位
#    EventType 通过 requiresSlot 声明所需槽位；KnowledgeUnit(EVENT型) 通过 hasSlot 声明已填充槽位
# =============================================================================
f:EventSlot a owl:Class ; rdfs:label "事件槽位"@zh ;
    rdfs:comment "事件论元槽位的枚举类；槽位作为命名个体。"@zh .

f:SlotCrop        a f:EventSlot, owl:NamedIndividual ; rdfs:label "作物槽(C)"@zh .
f:SlotDisease     a f:EventSlot, owl:NamedIndividual ; rdfs:label "病害槽(D)"@zh .
f:SlotPest        a f:EventSlot, owl:NamedIndividual ; rdfs:label "虫害槽(P)"@zh .
f:SlotSymptom     a f:EventSlot, owl:NamedIndividual ; rdfs:label "症状槽(S)"@zh .
f:SlotEnv         a f:EventSlot, owl:NamedIndividual ; rdfs:label "环境条件槽(A)"@zh .
f:SlotTreatment   a f:EventSlot, owl:NamedIndividual ; rdfs:label "防治措施槽(TREATMENT)"@zh .
f:SlotGrowthStage a f:EventSlot, owl:NamedIndividual ; rdfs:label "生育期槽(GROWTH_STAGE)"@zh .
f:SlotTime        a f:EventSlot, owl:NamedIndividual ; rdfs:label "时间槽(τ)"@zh .
f:SlotLocation    a f:EventSlot, owl:NamedIndividual ; rdfs:label "空间槽(λ)"@zh .
f:SlotTrait       a f:EventSlot, owl:NamedIndividual ; rdfs:label "性状槽"@zh .

# EventType → requiresSlot → EventSlot（声明各事件类型所需槽位）
f:requiresSlot a owl:ObjectProperty ; rdfs:label "需要槽位"@zh ;
    rdfs:domain f:EventType ; rdfs:range f:EventSlot .

f:DiseaseOccurrenceEvent f:requiresSlot f:SlotCrop, f:SlotDisease, f:SlotSymptom, f:SlotTime, f:SlotLocation, f:SlotEnv .
f:PestOccurrenceEvent    f:requiresSlot f:SlotCrop, f:SlotPest, f:SlotSymptom, f:SlotTime, f:SlotLocation, f:SlotEnv .
f:EnvironmentalInfluenceEvent f:requiresSlot f:SlotEnv, f:SlotCrop, f:SlotDisease, f:SlotTime .
f:ControlEvent           f:requiresSlot f:SlotCrop, f:SlotTreatment, f:SlotTime .
f:PhenologyEvent         f:requiresSlot f:SlotCrop, f:SlotGrowthStage, f:SlotTime .
f:SpreadEvent            f:requiresSlot f:SlotDisease, f:SlotLocation, f:SlotTime .
f:GrowthDevelopmentEvent f:requiresSlot f:SlotCrop, f:SlotGrowthStage, f:SlotTime .
f:QualityFormationEvent  f:requiresSlot f:SlotCrop, f:SlotTrait, f:SlotTime .

# =============================================================================
# 5. 时间三元组 / 空间三元组（结构化类）
#    对应文档 §5.1、§7.1；七元组的 t/l 通过 hasTimeTriple/hasSpaceTriple 结构化承载
# =============================================================================
f:TimeTriple a owl:Class ; rdfs:label "时间三元组"@zh ;
    rdfs:comment "t=(t_start, t_end, stage)，起止时间+生育期。"@zh .
f:tStart a owl:DatatypeProperty ; rdfs:label "开始时间"@zh ;
    rdfs:domain f:TimeTriple ; rdfs:range xsd:date .
f:tEnd a owl:DatatypeProperty ; rdfs:label "结束时间"@zh ;
    rdfs:domain f:TimeTriple ; rdfs:range xsd:date .
f:stage a owl:DatatypeProperty ; rdfs:label "生育期"@zh ;
    rdfs:domain f:TimeTriple ; rdfs:range xsd:string .

f:SpaceTriple a owl:Class ; rdfs:label "空间三元组"@zh ;
    rdfs:comment "l=(province, lon, lat)，省级行政区+经纬度。"@zh .
f:province a owl:DatatypeProperty ; rdfs:label "省份"@zh ;
    rdfs:domain f:SpaceTriple ; rdfs:range xsd:string .
f:lon a owl:DatatypeProperty ; rdfs:label "经度"@zh ;
    rdfs:domain f:SpaceTriple ; rdfs:range xsd:decimal .
f:lat a owl:DatatypeProperty ; rdfs:label "纬度"@zh ;
    rdfs:domain f:SpaceTriple ; rdfs:range xsd:decimal .

# =============================================================================
# 6. 证据（Evidence）—— 对应文档 §9 evidence 多模态溯源
# =============================================================================
f:Evidence a owl:Class ; rdfs:label "证据"@zh ;
    rdfs:comment "多模态证据：图像/文本/环境时序，供知识单元溯源与消融。"@zh .
f:evidenceType a owl:DatatypeProperty ; rdfs:label "证据类型"@zh ;
    rdfs:domain f:Evidence ; rdfs:range xsd:string ;
    rdfs:comment "image / text / env_series。"@zh .
f:evidenceUri a owl:DatatypeProperty ; rdfs:label "证据URI"@zh ;
    rdfs:domain f:Evidence ; rdfs:range xsd:anyURI .
f:evidenceRole a owl:DatatypeProperty ; rdfs:label "证据角色"@zh ;
    rdfs:domain f:Evidence ; rdfs:range xsd:string ;
    rdfs:comment "如 symptom_image / source_text / env_observation。"@zh .
f:evidenceConfidence a owl:DatatypeProperty ; rdfs:label "证据置信度"@zh ;
    rdfs:domain f:Evidence ; rdfs:range xsd:decimal .

# =============================================================================
# 7. 因果规则库（CausalRule）—— 对应文档 §6，四层结构之因果规则库
# =============================================================================
f:CausalRule a owl:Class ; rdfs:label "因果规则"@zh ;
    rdfs:comment "以 NY/T 标准为支撑的作物-病害-环境因果先验，形式为'环境条件→病害风险'。"@zh .
f:hasAntecedent a owl:ObjectProperty ; rdfs:label "前置条件"@zh ;
    rdfs:domain f:CausalRule ; rdfs:range f:EnvFactor ;
    rdfs:comment "规则的前置环境条件（如高温高湿）。"@zh .
f:hasConsequent a owl:ObjectProperty ; rdfs:label "后果"@zh ;
    rdfs:domain f:CausalRule ; rdfs:range f:Disease ;
    rdfs:comment "规则的后果病害（如稻瘟病）。"@zh .
f:riskLevel a owl:DatatypeProperty ; rdfs:label "风险等级"@zh ;
    rdfs:domain f:CausalRule ; rdfs:range xsd:string ;
    rdfs:comment "high / medium / low。"@zh .
f:ruleSource a owl:DatatypeProperty ; rdfs:label "规则来源"@zh ;
    rdfs:domain f:CausalRule ; rdfs:range xsd:string ;
    rdfs:comment "如 NY/T 标准编号、文献来源。"@zh .

# =============================================================================
# 8. 知识单元（七元组 ku=(s,r,o,t,l,c,m)）—— 对应文档 §7
# =============================================================================
f:KnowledgeUnit a owl:Class ; rdfs:label "知识单元"@zh ;
    rdfs:comment "七元组 ku=(s,r,o,t,l,c,m)；ku_type 判别 REL/EVENT。"@zh .

f:hasSubject a owl:ObjectProperty ; rdfs:label "主体(s)"@zh ;
    rdfs:domain f:KnowledgeUnit ; rdfs:range f:SemanticSubject .
f:hasObject a owl:ObjectProperty ; rdfs:label "客体(o)"@zh ;
    rdfs:domain f:KnowledgeUnit ; rdfs:range f:KnowledgeObject .
f:hasRelation a owl:ObjectProperty ; rdfs:label "关系/事件类型(r)"@zh ;
    rdfs:domain f:KnowledgeUnit ;
    rdfs:range [ owl:unionOf ( f:RelationType f:EventType ) ] ;
    rdfs:comment "指向关系类型个体(RelationType)或事件类型类(EventType，punning)，双态由 kuType 判别。"@zh .
f:hasTimeTriple a owl:ObjectProperty ; rdfs:label "时间三元组(t)"@zh ;
    rdfs:domain f:KnowledgeUnit ; rdfs:range f:TimeTriple .
f:hasSpaceTriple a owl:ObjectProperty ; rdfs:label "空间三元组(l)"@zh ;
    rdfs:domain f:KnowledgeUnit ; rdfs:range f:SpaceTriple .
f:hasSlot a owl:ObjectProperty ; rdfs:label "已填充槽位"@zh ;
    rdfs:domain f:KnowledgeUnit ; rdfs:range f:EventSlot ;
    rdfs:comment "EVENT 型知识单元声明已填充的槽位；槽位值由 hasSubject/hasObject/hasTimeTriple/hasSpaceTriple 承载。"@zh .
f:hasEvidence a owl:ObjectProperty ; rdfs:label "证据"@zh ;
    rdfs:domain f:KnowledgeUnit ; rdfs:range f:Evidence .

# ---- 8.1 事件间关联（v1.2 新增）----
# 在保持"事件是知识单元载体、不是图谱节点"定位不变的前提下，
# 在知识单元层定义事件间时序/因果/抑制关系，仅对 ku_type=EVENT 的知识单元有意义。
f:ku_precedes a owl:ObjectProperty ; rdfs:label "先于（事件间时序）"@zh ;
    rdfs:domain f:KnowledgeUnit ; rdfs:range f:KnowledgeUnit ;
    rdfs:comment "v1.2新增：本事件知识单元在时间上先于另一个事件知识单元；仅对 ku_type=EVENT 有意义；可通过 TimeTriple 比较自动生成。"@zh .
f:ku_causes a owl:ObjectProperty ; rdfs:label "导致/触发（事件间因果）"@zh ;
    rdfs:domain f:KnowledgeUnit ; rdfs:range f:KnowledgeUnit ;
    rdfs:comment "v1.2新增：本事件导致或触发了另一个事件（如环境影响事件→触发→病害发生事件）；仅对 EVENT 型有意义；可基于因果规则库+共享实体半自动生成。"@zh .
f:ku_inhibits a owl:ObjectProperty ; rdfs:label "抑制（事件间防治）"@zh ;
    rdfs:domain f:KnowledgeUnit ; rdfs:range f:KnowledgeUnit ;
    rdfs:comment "v1.2新增：本事件抑制了另一个事件的发生或扩散（如防治事件→抑制→扩散事件）；仅对 EVENT 型有意义；可基于防治事件+扩散事件+共享病害半自动生成。"@zh .

# 数据属性
f:confidence a owl:DatatypeProperty ; rdfs:label "融合置信度(c)"@zh ;
    rdfs:domain f:KnowledgeUnit ; rdfs:range xsd:decimal .
f:kuType a owl:DatatypeProperty ; rdfs:label "知识单元类型"@zh ;
    rdfs:domain f:KnowledgeUnit ; rdfs:range xsd:string ;
    rdfs:comment "REL / EVENT（修订 B 的 r 双态歧义）。"@zh .
f:mText a owl:DatatypeProperty ; rdfs:label "文本模态可用"@zh ;
    rdfs:domain f:KnowledgeUnit ; rdfs:range xsd:boolean .
f:mImg a owl:DatatypeProperty ; rdfs:label "图像模态可用"@zh ;
    rdfs:domain f:KnowledgeUnit ; rdfs:range xsd:boolean .
f:mEnv a owl:DatatypeProperty ; rdfs:label "环境模态可用"@zh ;
    rdfs:domain f:KnowledgeUnit ; rdfs:range xsd:boolean .

# 实体通用标识（对应文档 §9 uri/aliases）
f:entityUri a owl:DatatypeProperty ; rdfs:label "实体URI"@zh ;
    rdfs:domain f:Entity ; rdfs:range xsd:anyURI ;
    rdfs:comment "实体唯一标识，优先复用 AGROVOC/CO/PO 编码。"@zh .
f:entityAliases a owl:DatatypeProperty ; rdfs:label "别名"@zh ;
    rdfs:domain f:Entity ; rdfs:range xsd:string ;
    rdfs:comment "别名列表，用于同义归一。"@zh .

# =============================================================================
# 9. 核心关系（10 类，domain/range 用 unionOf 精确收紧，对应文档 §3.1）
# =============================================================================
f:affects a owl:ObjectProperty ;
    rdfs:label "危害"@zh ; rdfs:comment "新增：病害/虫害→危害→作物（B 缺失的核心边）。"@zh ;
    rdfs:domain [ owl:unionOf ( f:Disease f:Pest ) ] ; rdfs:range f:Crop .
f:influence a owl:ObjectProperty ;
    rdfs:label "影响"@zh ; rdfs:comment "affect 拆分①：环境→影响→作物。"@zh ;
    rdfs:domain f:EnvFactor ; rdfs:range f:Crop .
f:favor a owl:ObjectProperty ;
    rdfs:label "促进"@zh ; rdfs:comment "affect 拆分②/病三角：环境→促进→病害/虫害。"@zh ;
    rdfs:domain f:EnvFactor ; rdfs:range [ owl:unionOf ( f:Disease f:Pest ) ] .
f:exhibit a owl:ObjectProperty ;
    rdfs:label "表现"@zh ; rdfs:comment "病害/虫害→表现→症状。"@zh ;
    rdfs:domain [ owl:unionOf ( f:Disease f:Pest ) ] ; rdfs:range f:Symptom .
f:causedBy a owl:ObjectProperty ;
    rdfs:label "由病原引起"@zh ; rdfs:comment "新增：病害→由病原引起→病原。"@zh ;
    rdfs:domain f:Disease ; rdfs:range f:Pathogen .
f:treat a owl:ObjectProperty ;
    rdfs:label "防治"@zh ; rdfs:comment "措施→防治→病害/虫害。"@zh ;
    rdfs:domain f:Treatment ; rdfs:range [ owl:unionOf ( f:Disease f:Pest ) ] .
f:occurIn a owl:ObjectProperty ;
    rdfs:label "发生于"@zh ;
    rdfs:comment "修订：主体由 EVENT 改为 病害/虫害 → 客体 生育期/时间（修复 B 形式化矛盾）。"@zh ;
    rdfs:domain [ owl:unionOf ( f:Disease f:Pest ) ] ;
    rdfs:range [ owl:unionOf ( f:GrowthStage f:Time ) ] .
f:dependOn a owl:ObjectProperty ;
    rdfs:label "依赖"@zh ; rdfs:comment "病害/虫害→依赖→环境因子；与 favor 互为逆语义。"@zh ;
    rdfs:domain [ owl:unionOf ( f:Disease f:Pest ) ] ; rdfs:range f:EnvFactor .
f:spreadIn a owl:ObjectProperty ;
    rdfs:label "扩散于"@zh ; rdfs:comment "病害/虫害→扩散于→空间。"@zh ;
    rdfs:domain [ owl:unionOf ( f:Disease f:Pest ) ] ; rdfs:range f:Location .
f:resist a owl:ObjectProperty ;
    rdfs:label "抗性"@zh ; rdfs:comment "新增（可选）：作物→抗→病害/虫害。"@zh ;
    rdfs:domain f:Crop ; rdfs:range [ owl:unionOf ( f:Disease f:Pest ) ] .

# 逆语义声明：favor(Env→D/P) ⇔ dependOn(D/P→Env)
f:favor owl:inverseOf f:dependOn .

# =============================================================================
# 10. 观测关系（4 类，图谱增强层，不进入核心语义 Mask）
# =============================================================================
f:measures a owl:ObjectProperty ; rdfs:label "测量"@zh ;
    rdfs:domain f:Observation ; rdfs:range f:EnvFactor .
f:observedAt a owl:ObjectProperty ; rdfs:label "观测时间"@zh ;
    rdfs:domain f:Observation ; rdfs:range f:Time .
f:observedIn a owl:ObjectProperty ; rdfs:label "观测地点"@zh ;
    rdfs:domain f:Observation ; rdfs:range f:Location .
f:depicts a owl:ObjectProperty ; rdfs:label "描绘"@zh ;
    rdfs:domain f:Observation ; rdfs:range f:Entity .

# =============================================================================
# 11. 约束公理（基数/全称约束，对应合法配对 Mask 的 OWL 化）
# =============================================================================
f:KnowledgeUnit rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty f:hasSubject ; owl:minQualifiedCardinality 1 ; owl:onClass f:SemanticSubject ] .
f:KnowledgeUnit rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty f:confidence ; owl:minCardinality 1 ] .
f:KnowledgeUnit rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty f:kuType ; owl:minCardinality 1 ] .
f:Disease rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty f:causedBy ; owl:minQualifiedCardinality 1 ; owl:onClass f:Pathogen ] .

# =============================================================================
# 12. 示例个体（ABox：以稻瘟病为例演示完整关系链 + 因果规则 + 证据 + 事件知识单元）
# =============================================================================

# ---- 12.1 实体示例 ----
f:Rice a f:Crop ; rdfs:label "水稻"@zh ; f:entityUri "agrovoc:c_2630" ; f:resist f:Blast .
f:Blast a f:Disease ; rdfs:label "稻瘟病"@zh ;
    f:affects f:Rice ;
    f:exhibit f:LeafLesion ;
    f:causedBy f:Pyricularia ;
    f:occurIn f:BootingStage ;
    f:occurIn f:June2026 ;
    f:dependOn f:HighHumidity ;
    f:spreadIn f:SouthChina .
f:Pyricularia a f:Pathogen ; rdfs:label "稻瘟病菌"@zh .
f:LeafLesion a f:FoliarSymptom ; rdfs:label "叶部梭形病斑"@zh .
f:BootingStage a f:GrowthStage ; rdfs:label "孕穗期"@zh .
f:June2026 a f:TimeInterval ; rdfs:label "2026年6月"@zh .
f:HighHumidity a f:HumidityParam ; rdfs:label "高湿"@zh .
f:HighTempHighHumidity a f:HumidityParam ; rdfs:label "高温高湿"@zh ; f:favor f:Blast .
f:SouthChina a f:Region ; rdfs:label "华南稻区"@zh .
f:Tricyclazole a f:Treatment ; rdfs:label "三环唑"@zh ; f:treat f:Blast .

# ---- 12.2 因果规则示例（对应文档 §6）----
f:Rule_HighHumidity_Blast a f:CausalRule ; rdfs:label "高湿→稻瘟病风险↑"@zh ;
    f:hasAntecedent f:HighHumidity ; f:hasConsequent f:Blast ;
    f:riskLevel "high" ; f:ruleSource "NY/T 标准" .

# ---- 12.3 证据示例（对应文档 §9 evidence）----
f:Ev_Img_1023 a f:Evidence ; rdfs:label "稻瘟病叶部症状图"@zh ;
    f:evidenceType "image" ; f:evidenceUri "obs://img/1023" ;
    f:evidenceRole "symptom_image" ; f:evidenceConfidence 0.95 .
f:Ev_Env_0521 a f:Evidence ; rdfs:label "华南稻区6月温湿度序列"@zh ;
    f:evidenceType "env_series" ; f:evidenceUri "obs://env/0521" ;
    f:evidenceRole "env_observation" ; f:evidenceConfidence 0.90 .

# ---- 12.4 时间/空间三元组示例 ----
f:TT_202606 a f:TimeTriple ;
    f:tStart "2026-06-01"^^xsd:date ; f:tEnd "2026-06-30"^^xsd:date ; f:stage "孕穗期" .
f:ST_SouthChina a f:SpaceTriple ;
    f:province "广东省" ; f:lon 113.27 ; f:lat 23.13 .

# ---- 12.5 知识单元示例（REL 型）----
f:ku_blast_affects_rice a f:KnowledgeUnit ;
    f:kuType "REL" ;
    f:hasSubject f:Blast ;
    f:hasRelation f:RelAffects ;
    f:hasObject f:Rice ;
    f:hasTimeTriple f:TT_202606 ;
    f:hasSpaceTriple f:ST_SouthChina ;
    f:confidence 0.93 ;
    f:mText true ; f:mImg false ; f:mEnv true ;
    f:hasEvidence f:Ev_Env_0521 .

# ---- 12.6 知识单元示例（EVENT 型：病害发生事件，含槽位声明）----
f:ku_event_blast_202606 a f:KnowledgeUnit ;
    f:kuType "EVENT" ;
    f:hasRelation f:DiseaseOccurrenceEvent ;
    f:hasSubject f:Blast ;
    f:hasObject f:Rice ;
    f:hasTimeTriple f:TT_202606 ;
    f:hasSpaceTriple f:ST_SouthChina ;
    f:hasSlot f:SlotCrop, f:SlotDisease, f:SlotSymptom, f:SlotTime, f:SlotLocation, f:SlotEnv ;
    f:confidence 0.88 ;
    f:mText true ; f:mImg true ; f:mEnv true ;
    f:hasEvidence f:Ev_Img_1023, f:Ev_Env_0521 .

# ---- 12.7 事件链示例（v1.2 新增：演示事件间关联 ku_causes/ku_precedes/ku_inhibits）----
# 事件链：高温高湿(环境影响) →触发→ 稻瘟病发生 →先于→ 三环唑防治 →抑制→ 稻瘟病扩散
f:TT_202607 a f:TimeTriple ;
    f:tStart "2026-07-01"^^xsd:date ; f:tEnd "2026-07-31"^^xsd:date ; f:stage "抽穗期" .
f:TT_202607_08 a f:TimeTriple ;
    f:tStart "2026-07-15"^^xsd:date ; f:tEnd "2026-08-31"^^xsd:date ; f:stage "抽穗-灌浆期" .
f:ST_Yangtze a f:SpaceTriple ;
    f:province "长江流域" ; f:lon 114.30 ; f:lat 30.59 .

# 环境影响事件：高温高湿
f:ku_env_highhumidity a f:KnowledgeUnit ;
    f:kuType "EVENT" ;
    f:hasRelation f:EnvironmentalInfluenceEvent ;
    f:hasSubject f:HighTempHighHumidity ;
    f:hasObject f:Rice ;
    f:hasTimeTriple f:TT_202606 ;
    f:hasSpaceTriple f:ST_SouthChina ;
    f:hasSlot f:SlotEnv, f:SlotCrop, f:SlotDisease, f:SlotTime ;
    f:confidence 0.90 ;
    f:mText true ; f:mImg false ; f:mEnv true ;
    f:hasEvidence f:Ev_Env_0521 ;
    f:ku_causes f:ku_event_blast_202606 .   # 环境影响 →触发→ 病害发生

# 防治事件：三环唑
f:ku_control_tricyclazole a f:KnowledgeUnit ;
    f:kuType "EVENT" ;
    f:hasRelation f:ControlEvent ;
    f:hasSubject f:Tricyclazole ;
    f:hasObject f:Blast ;
    f:hasTimeTriple f:TT_202607 ;
    f:hasSpaceTriple f:ST_SouthChina ;
    f:hasSlot f:SlotCrop, f:SlotTreatment, f:SlotTime ;
    f:confidence 0.92 ;
    f:mText true ; f:mImg false ; f:mEnv false ;
    f:ku_inhibits f:ku_spread_blast .   # 防治 →抑制→ 扩散

# 扩散事件：稻瘟病从华南扩散到长江流域
f:ku_spread_blast a f:KnowledgeUnit ;
    f:kuType "EVENT" ;
    f:hasRelation f:SpreadEvent ;
    f:hasSubject f:Blast ;
    f:hasObject f:SouthChina ;
    f:hasTimeTriple f:TT_202607_08 ;
    f:hasSpaceTriple f:ST_Yangtze ;
    f:hasSlot f:SlotDisease, f:SlotLocation, f:SlotTime ;
    f:confidence 0.75 ;
    f:mText true ; f:mImg false ; f:mEnv false .

# 病害发生事件 →先于→ 防治事件（补充时序关联）
f:ku_event_blast_202606 f:ku_precedes f:ku_control_tricyclazole .

# ---- 12.8 观测（多模态挂载）----
f:obs_img_1023 a f:ImageAsset ; rdfs:label "稻瘟病叶部症状图"@zh ;
    f:depicts f:LeafLesion ; f:observedIn f:SouthChina ; f:observedAt f:June2026 .
